            <g class="chibi-head">
                <circle cx="22" cy="60" r="7" fill="#fce2d6"/>
                <circle cx="98" cy="60" r="7" fill="#fce2d6"/>
                <rect x="25" y="35" width="70" height="50" rx="20" fill="#fce2d6"/>
                <circle cx="38" cy="67" r="6" fill="#ff94b8" opacity="0.6"/>
                <circle cx="82" cy="67" r="6" fill="#ff94b8" opacity="0.6"/>
                <circle cx="45" cy="59" r="5.5" fill="#333"/>
                <circle cx="75" cy="59" r="5.5" fill="#333"/>
                <circle cx="43" cy="57" r="2" fill="#fff"/>
                <circle cx="73" cy="57" r="2" fill="#fff"/>
                <path d="M54,69 Q60,75 66,69" fill="none" stroke="#333" stroke-width="3" stroke-linecap="round"/>
            </g>
            <g class="chibi-hair">
                <path d="M22,47 C20,20 40,13 60,17 C80,13 100,20 98,47 C104,50 100,33 92,29 C85,20 75,19 60,23 C45,19 35,20 28,29 C20,33 16,50 22,47 Z" fill="#cfab6a"/>
                <path d="M25,41 Q40,37 45,49 Q52,35 60,45 Q68,35 75,49 Q85,37 95,41 L95,31 L25,31 Z" fill="#cfab6a"/>
            </g>
            <g class="chibi-bday-hat">
                <path d="M60,2 L42,32 L78,32 Z" fill="#ff4757"/>
                <path d="M51,13 L45,23 L50,26 L56,15 Z" fill="#ffa502"/>
                <path d="M63,7 L55,20 L60,23 L68,10 Z" fill="#2ed573"/>
                <path d="M69,17 L62,29 L67,31 L74,20 Z" fill="#1e90ff"/>
                <ellipse cx="60" cy="32" rx="19" ry="3.5" fill="#ffffff"/>
                <circle cx="60" cy="2" r="4.5" fill="#ffd700"/>
            </g>
        </svg>
    </div>

    <!-- 1. SCREEN: LOCK / PASSWORD -->
    <div id="screen-lock" class="screen active">
        <div class="layout-container" id="lockCard">
            <div class="visual-side">
                <div class="mascot-wrapper">
                    <div id="mascot-placeholder-1"></div>
                    <div class="mascot-cloud-floor"></div>
                </div>
            </div>
            <div class="interface-side">
                <h2 class="password-title">Guess the password</h2>
                <div class="slots-container">
                    <div class="slot" id="slot-0"></div>
                    <div class="slot" id="slot-1"></div>
                    <div class="slot" id="slot-2"></div>
                </div>
                <!-- Complete Keypad (1 to 9, 0, and clear) -->
                <div class="keypad-grid">
                    <button class="key-btn" onclick="pressKey('1')">1</button>
                    <button class="key-btn" onclick="pressKey('2')">2</button>
                    <button class="key-btn" onclick="pressKey('3')">3</button>
                    <button class="key-btn" onclick="pressKey('4')">4</button>
                    <button class="key-btn" onclick="pressKey('5')">5</button>
                    <button class="key-btn" onclick="pressKey('6')">6</button>
                    <button class="key-btn" onclick="pressKey('7')">7</button>
                    <button class="key-btn" onclick="pressKey('8')">8</button>
                    <button class="key-btn" onclick="pressKey('9')">9</button>
                    <button class="key-btn special" onclick="clearKeys()">C</button>
                    <button class="key-btn" onclick="pressKey('0')">0</button>
                    <button class="key-btn special" onclick="clearKeys()">#</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. SCREEN: DIALOGUE (TODAY IS MY BIRTHDAY) -->
    <div id="screen-dialogue" class="screen">
        <div class="dialogue-box-container">
            <div class="speech-bubble">
                Today is my birthday!!!! 🎂✨
            </div>
            <div class="mascot-wrapper" style="margin-bottom: 30px;">
                <div id="mascot-placeholder-2"></div>
                <div class="mascot-cloud-floor"></div>
            </div>
            <button class="btn-next" onclick="navigateTo('screen-celebration')">Next ➔</button>
        </div>
    </div>

    <!-- 3. SCREEN: FINAL CELEBRATION -->
    <div id="screen-celebration" class="screen">
        <div class="celebration-wrapper">
            <h1 class="main-bday-title">🎉 HAPPY BIRTHDAY ABDOLLAH 🎉</h1>
            <div style="display: flex; justify-content: center; gap: 15px; margin-bottom: 15px;">
                <div class="mascot-wrapper" style="transform: scale(0.85); margin: -10px 0;">
                    <div id="mascot-placeholder-3"></div>
                </div>
            </div>
            <div class="scrolling-letter" id="typedLetter"></div>
            <div class="controls-row">
                <button class="btn-action" onclick="triggerMassiveExplosions()">🔄 Blast Effects</button>
                <button class="btn-action" id="audioToggleBtn" onclick="toggleAudioStream()">🎵 Play Music</button>
            </div>
        </div>
    </div>

    <audio id="bdayAudio" loop preload="auto">
        <source src="https://assets.mixkit.co/active_storage/sfx/123/123-200.wav" type="audio/wav">
    </audio>

    <script>
        const originalSvgHtml = document.getElementById('chibi-boy-svg').outerHTML;
        document.getElementById('mascot-placeholder-1').innerHTML = originalSvgHtml;
        document.getElementById('mascot-placeholder-2').innerHTML = originalSvgHtml;
        document.getElementById('mascot-placeholder-3').innerHTML = originalSvgHtml;

        function navigateTo(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            setTimeout(() => {
                const target = document.getElementById(screenId);
                target.classList.add('active');
                if(screenId === 'screen-celebration') {
                    startCelebrationEngine();
                }
            }, 300);
        }

        let currentPin = "";
        const targetPin = "730";

        function pressKey(number) {
            if (currentPin.length < 3 && !isNaN(number)) {
                currentPin += number;
                updatePinSlots();
                if (currentPin.length === 3) {
                    setTimeout(verifyPin, 250);
                }
            }
        }

        function clearKeys() {
            currentPin = "";
            updatePinSlots();
        }

        function updatePinSlots() {
            for(let i=0; i<3; i++) {
                const slot = document.getElementById(`slot-${i}`);
                if(i < currentPin.length) {
                    slot.innerText = "⭐";
                    slot.classList.add('filled');
                } else {
                    slot.innerText = "";
                    slot.classList.remove('filled');
                }
            }
        }

        function verifyPin() {
            if (currentPin === targetPin) {
                navigateTo('screen-dialogue');
            } else {
                const card = document.getElementById('lockCard');
                card.classList.add('error-shake');
                card.addEventListener('animationend', () => card.classList.remove('error-shake'), {once: true});
                clearKeys();
            }
        }

        const canvas = document.getElementById('effectsCanvas');
        const ctx = canvas.getContext('2d');
        let confettiArray = [];
        let fireworkSparkArray = [];
        let systemActive = false;

        function resizeCanvasEngine() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvasEngine);
        resizeCanvasEngine();

        class ConfettiPiece {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * -60 - 20;
                this.size = 5 + Math.random() * 8;
                this.color = `hsl(${Math.random() * 360}, 100%, 65%)`;
                this.fallSpeed = 2 + Math.random() * 3.5;
                this.driftSpeed = -1 + Math.random() * 2;
                this.rotation = Math.random() * 360;
                this.rotSpeed = -3 + Math.random() * 6;
            }
            update() {
                this.y += this.fallSpeed;
                this.x += this.driftSpeed;
                this.rotation += this.rotSpeed;
                if(this.y > canvas.height) {
                    this.y = -20;
                    this.x = Math.random() * canvas.width;
                }
            }
            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation * Math.PI / 180);
                ctx.fillStyle = this.color;
                ctx.fillRect(-this.size/2, -this.size/2, this.size, this.size);
                ctx.restore();
            }
        }

        class FireworkBurstSpark {
            constructor(x, y, color) {
                this.x = x; this.y = y; this.color = color;
                this.angle = Math.random() * Math.PI * 2;
                this.speed = 1 + Math.random() * 5;
                this.opacity = 1;
                this.decay = 0.012 + Math.random() * 0.018;
                this.gravity = 0.08;
            }
            update() {
                this.x += Math.cos(this.angle) * this.speed;
                this.y += Math.sin(this.angle) * this.speed + this.gravity;
                this.opacity -= this.decay;
            }
            draw() {
                ctx.save();
                ctx.globalAlpha = this.opacity;
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, 3, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        function spawnFirework() {
            if(!systemActive) return;
            const x = 80 + Math.random() * (canvas.width - 160);
            const y = 80 + Math.random() * (canvas.height / 2);
            const palette = ['#ff7bb0', '#ffc107', '#20c997', '#00f3ff', '#ff3366', '#ffff00'];
            const color = palette[Math.floor(Math.random() * palette.length)];
            for(let i=0; i<50; i++) {
                fireworkSparkArray.push(new FireworkBurstSpark(x, y, color));
            }
        }

        const ballContainer = document.getElementById('balloonContainer');
        function spawnBalloon() {
            if(!systemActive) return;
            const b = document.createElement('div');
            b.classList.add('pure-balloon');
            const colorGradients = [
                'linear-gradient(135deg, #ff94b8 0%, #d6417a 100%)',
                'linear-gradient(135deg, #ffdf65 0%, #e0aa00 100%)',
                'linear-gradient(135deg, #7beaff 0%, #1094ab 100%)',
                'linear-gradient(135deg, #b19ffb 0%, #6849ed 100%)'
            ];
            b.style.background = colorGradients[Math.floor(Math.random() * colorGradients.length)];
            b.style.left = Math.random() * 92 + 'vw';
            const scale = 0.8 + Math.random() * 0.5;
            b.style.transform = `scale(${scale})`;
            b.style.animationDuration = (6 + Math.random() * 5) + 's';
            ballContainer.appendChild(b);
            b.addEventListener('animationend', () => b.remove());
        }

        function engineRenderLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            confettiArray.forEach(p => { p.update(); p.draw(); });
            fireworkSparkArray.forEach((f, idx) => {
                f.update();
                if(f.opacity <= 0) fireworkSparkArray.splice(idx, 1);
                else f.draw();
            });
            requestAnimationFrame(engineRenderLoop);
        }

        function startCelebrationEngine() {
            systemActive = true;
            confettiArray = [];
            for(let i=0; i<90; i++) confettiArray.push(new ConfettiPiece());
            engineRenderLoop();
            setInterval(spawnFirework, 750);
            setInterval(spawnBalloon, 900);
            triggerMassiveExplosions();
            typeWriterAnimation();
        }

        function typeWriterAnimation() {
            const container = document.getElementById('typedLetter');
            const text = "HAPPY BIRTHDAY TO ME! 🎉 Wishing myself a wonderful 16th birthday! May this year bring me endless joy, amazing successes, and unforgettable moments. Cheers to turning 16 and stepping into an incredible new chapter of life! 🌟✨";
            container.innerText = "";
            let idx = 0;
            function type() {
                if(idx < text.length) {
                    container.innerHTML += text.charAt(idx);
                    idx++;
                    setTimeout(type, 50);
                }
            }
            setTimeout(type, 300);
        }

        function triggerMassiveExplosions() {
            for(let c=0; c<3; c++) {
                setTimeout(() => {
                    const x = Math.random() * canvas.width;
                    const y = Math.random() * (canvas.height / 2);
                    const color = `hsl(${Math.random() * 360}, 100%, 60%)`;
                    for(let i=0; i<60; i++) fireworkSparkArray.push(new FireworkBurstSpark(x, y, color));
                }, c * 200);
            }
        }

        let playing = false;
        const audio = document.getElementById('bdayAudio');
        const btnText = document.getElementById('audioToggleBtn');

        function toggleAudioStream() {
            if(!playing) {
                audio.play().then(() => {
                    playing = true;
                    btnText.innerText = "⏸️ Pause Music";
                }).catch(() => console.log("Interaction restriction applied"));
            } else {
                audio.pause();
                playing = false;
                btnText.innerText = "🎵 Play Music";
            }
        }
    </script>
</body>
</html>
