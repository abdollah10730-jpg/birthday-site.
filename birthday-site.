<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Abdollah 🎉</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Poppins:wght@400;600;800&family=Cairo:wght@700&display=swap');

        :root {
            --pastel-sky: linear-gradient(180deg, #4aa3ff 0%, #7ec0ff 40%, #cbe3ff 100%);
            --card-bg: #f5f9ff;
            --blue-accent: #3b82f6;
            --blue-dark: #1e3a8a;
            --text-dark: #2c3e50;
            --gold: #ffd700;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body {
            background: var(--pastel-sky);
            color: var(--text-dark);
            font-family: 'Fredoka', 'Poppins', 'Cairo', sans-serif;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
            position: relative;
        }

        /* --- Clouds Background Animation --- */
        .clouds-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
            overflow: hidden;
        }

        .cloud {
            position: absolute;
            background: rgba(255, 255, 255, 0.85);
            border-radius: 100px;
            animation: floatClouds 25s linear infinite;
            filter: drop-shadow(0 4px 6px rgba(0,0,0,0.05));
        }
        .cloud::before, .cloud::after {
            content: '';
            position: absolute;
            background: rgba(255, 255, 255, 0.85);
            border-radius: 50%;
        }
        .cloud.c1 { width: 150px; height: 50px; top: 15%; left: -160px; animation-duration: 35s; }
        .cloud.c1::before { width: 70px; height: 70px; top: -35px; left: 20px; }
        .cloud.c1::after { width: 50px; height: 50px; top: -20px; left: 80px; }

        .cloud.c2 { width: 220px; height: 60px; top: 35%; left: -230px; animation-duration: 25s; animation-delay: 5s; }
        .cloud.c2::before { width: 90px; height: 90px; top: -50px; left: 30px; }
        .cloud.c2::after { width: 70px; height: 70px; top: -30px; left: 110px; }

        .cloud.c3 { width: 120px; height: 40px; top: 65%; left: -130px; animation-duration: 42s; animation-delay: 2s; }
        .cloud.c3::before { width: 50px; height: 50px; top: -25px; left: 15px; }
        .cloud.c3::after { width: 40px; height: 40px; top: -15px; left: 55px; }

        @keyframes floatClouds {
            0% { transform: translateX(-10px); }
            100% { transform: translateX(calc(100vw + 250px)); }
        }

        /* --- Canvas for Celebration Particles --- */
        #effectsCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 2;
        }
        #balloonContainer {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 3;
        }

        /* --- Screen Architecture --- */
        .screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10;
            padding: 20px;
            opacity: 0;
            transform: scale(0.98);
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        .screen.active {
            display: flex;
            opacity: 1;
            transform: scale(1);
        }

        /* --- Split Layout for Password Screen --- */
        .layout-container {
            display: flex;
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 4px solid #ffffff;
            border-radius: 32px;
            box-shadow: 0 15px 35px rgba(30, 58, 138, 0.15);
            width: 100%;
            max-width: 820px;
            overflow: hidden;
            min-height: 520px;
        }

        .visual-side {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            background: rgba(255, 255, 255, 0.15);
            padding: 20px;
        }

        .interface-side {
            flex: 1.1;
            background: var(--card-bg);
            padding: 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-left: 4px solid #ffffff;
        }

        /* --- Cute Boy Mascot Animation --- */
        .mascot-wrapper {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            animation: floatMascot 3s infinite ease-in-out;
        }

        @keyframes floatMascot {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-12px); }
        }

        .chibi-bday-hat { transform-origin: 60px 25px; animation: hatBob 3s infinite ease-in-out; }
        .chibi-hair { transform-origin: 60px 45px; animation: hairSway 4s infinite ease-in-out; }
        .chibi-head { transform-origin: 60px 75px; animation: headNod 3s infinite ease-in-out; }
        .chibi-arm-left { transform-origin: 42px 85px; animation: armWave 2s infinite ease-in-out; }
        .chibi-arm-right { transform-origin: 78px 85px; animation: armWaveRight 2s infinite ease-in-out; }

        @keyframes hatBob { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-3px) rotate(3deg); } }
        @keyframes hairSway { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(2deg); } }
        @keyframes headNod { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(-2deg); } }
        @keyframes armWave { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(-15deg); } }
        @keyframes armWaveRight { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(15deg); } }

        .mascot-cloud-floor {
            width: 140px;
            height: 35px;
            background: #ffffff;
            border-radius: 50px;
            margin-top: -10px;
            box-shadow: 0 8px 0px rgba(160, 195, 255, 0.4);
            position: relative;
        }
        .mascot-cloud-floor::before {
            content: ''; position: absolute; background: #fff; width: 60px; height: 60px; top: -30px; left: 20px; border-radius: 50%;
        }
        .mascot-cloud-floor::after {
            content: ''; position: absolute; background: #fff; width: 50px; height: 50px; top: -20px; left: 70px; border-radius: 50%;
        }

        /* --- Keypad / Password UI --- */
        .password-title {
            font-size: 1.6rem;
            color: var(--blue-dark);
            font-weight: 700;
            margin-bottom: 15px;
            text-shadow: 1px 1px 0px #fff;
        }

        .slots-container {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .slot {
            width: 42px;
            height: 42px;
            background: #fff;
            border: 3px solid #c6ddff;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.4rem;
            color: var(--blue-accent);
            transition: all 0.2s ease;
        }
        .slot.filled {
            border-color: var(--blue-accent);
            background: #edf4ff;
        }

        .keypad-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            width: 100%;
            max-width: 220px;
        }

        .key-btn {
            background: #ffffff;
            border: 3px solid #c6ddff;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-dark);
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 0px #c6ddff;
            transition: all 0.1s ease;
            font-family: 'Fredoka', sans-serif;
            margin: 0 auto;
        }
        .key-btn:active {
            transform: translateY(4px);
            box-shadow: 0 0px 0px #c6ddff;
        }
        .key-btn.special {
            color: var(--blue-dark);
            background: #edf4ff;
        }

        /* --- Screen 2: Dialogue Box Style --- */
        .dialogue-box-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            max-width: 500px;
            width: 100%;
        }

        .speech-bubble {
            background: #ffffff;
            border: 4px solid var(--text-dark);
            border-radius: 24px;
            padding: 25px 30px;
            position: relative;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--text-dark);
            text-align: center;
            width: 100%;
            margin-bottom: 35px;
            box-shadow: 0 10px 0px rgba(74, 59, 82, 0.1);
            animation: popBubble 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .speech-bubble::after {
            content: '';
            position: absolute;
            bottom: -24px;
            left: 50%;
            transform: translateX(-50%);
            border-width: 24px 20px 0;
            border-style: solid;
            border-color: #ffffff transparent;
            display: block;
            width: 0;
        }

        .speech-bubble::before {
            content: '';
            position: absolute;
            bottom: -30px;
            left: 50%;
            transform: translateX(-50%);
            border-width: 26px 22px 0;
            border-style: solid;
            border-color: var(--text-dark) transparent;
            display: block;
            width: 0;
            z-index: -1;
        }

        @keyframes popBubble {
            0% { transform: scale(0.7); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .btn-next {
            background: linear-gradient(135deg, #64a5ff 0%, #1e3a8a 100%);
            border: 4px solid #ffffff;
            padding: 15px 50px;
            font-size: 1.4rem;
            color: white;
            font-weight: 700;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(30, 58, 138, 0.25);
            transition: transform 0.2s, box-shadow 0.2s;
            font-family: 'Fredoka', sans-serif;
        }
        .btn-next:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(30, 58, 138, 0.35);
        }
        .btn-next:active {
            transform: translateY(1px);
        }

        /* --- Final Celebration Screen --- */
        .celebration-wrapper {
            text-align: center;
            max-width: 700px;
            z-index: 5;
            background: rgba(255, 255, 255, 0.65);
            padding: 40px;
            border-radius: 32px;
            border: 4px solid #fff;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06);
        }

        .main-bday-title {
            font-size: 3.2rem;
            font-weight: 800;
            background: linear-gradient(to right, #e83e8c, #fd7e14, #ffc107, #20c997, #2563eb, #e83e8c);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: streamText 3s linear infinite;
            margin-bottom: 20px;
        }

        @keyframes streamText {
            0% { background-position: 0% center; }
            100% { background-position: 200% center; }
        }

        .scrolling-letter {
            font-size: 1.35rem;
            font-weight: 600;
            line-height: 1.8;
            color: #2c3e50;
            min-height: 120px;
        }

        .controls-row {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 30px;
        }

        .btn-action {
            background: white;
            border: 3px solid var(--blue-accent);
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 50px;
            color: var(--blue-dark);
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Fredoka', sans-serif;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        .btn-action:hover {
            background: var(--blue-accent);
            color: white;
            transform: translateY(-2px);
        }

        /* --- Pure CSS Balloons --- */
        .pure-balloon {
            position: absolute;
            width: 70px;
            height: 85px;
            border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
            bottom: -120px;
            box-shadow: inset -6px -10px 15px rgba(0,0,0,0.1), 0 10px 20px rgba(0,0,0,0.08);
            animation: ascend 9s linear infinite;
        }
        .pure-balloon::before {
            content: ""; position: absolute; bottom: -6px; left: 50%; transform: translateX(-50%);
            border-left: 5px solid transparent; border-right: 5px solid transparent;
        }
        .pure-balloon::after {
            content: ""; position: absolute; bottom: -30px; left: 50%; width: 1.5px; height: 25px; background: rgba(0,0,0,0.15);
        }
        @keyframes ascend {
            0% { transform: translateY(0) rotate(0deg); opacity: 0; }
            10% { opacity: 0.9; }
            100% { transform: translateY(-120vh) rotate(15deg); opacity: 0; }
        }

        @media (max-width: 768px) {
            .layout-container { flex-direction: column; width: 95%; min-height: auto; }
            .interface-side { border-left: none; border-top: 4px solid #ffffff; padding: 25px 15px; }
            .main-bday-title { font-size: 2.2rem; }
            .speech-bubble { font-size: 1.3rem; }
        }

        .error-shake {
            animation: shake 0.4s ease-in-out;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-10px); }
            40%, 80% { transform: translateX(10px); }
        }
    </style>
</head>
<body>

    <!-- Background Elements -->
    <div class="clouds-bg">
        <div class="cloud c1"></div>
        <div class="cloud c2"></div>
        <div class="cloud c3"></div>
    </div>
    <canvas id="effectsCanvas"></canvas>
    <div id="balloonContainer"></div>

    <!-- SVG CHARACTER MACRO (Boy, Fair Skin, Light Brown-Yellowish Hair + Birthday Hat) -->
    <div style="display:none;">
        <svg id="chibi-boy-svg" viewBox="0 0 120 155" width="120" height="155">
            <ellipse cx="60" cy="145" rx="30" ry="6" fill="rgba(0,0,0,0.08)"/>
            <rect x="44" y="120" width="12" height="20" rx="4" fill="#5e6a7e"/>
            <rect x="64" y="120" width="12" height="20" rx="4" fill="#5e6a7e"/>
